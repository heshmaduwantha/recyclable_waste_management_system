{
  "name": "eco-collect-backend",
  "version": "1.0.0",
  "description": "EcoCollect Recyclable Waste Management System Express & PostgreSQL Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/setup.ts migrate",
    "db:seed": "tsx src/db/setup.ts seed",
    "db:setup": "tsx src/db/setup.ts all",
    "test:api": "node tests/api.qa.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
